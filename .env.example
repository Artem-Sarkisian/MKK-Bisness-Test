API_KEY=replace-with-a-long-random-api-key
POSTGRES_PASSWORD=replace-with-database-password
RABBITMQ_PASSWORD=replace-with-broker-password
DATABASE_URL=postgresql+asyncpg://payments:replace-with-database-password@localhost:55432/payments
RABBITMQ_URL=amqp://payments:replace-with-broker-password@localhost:55672/
WEBHOOK_TIMEOUT=5
WEBHOOK_ALLOWED_HOSTS=[]
RETRY_BASE_SECONDS=2
OUTBOX_POLL_SECONDS=0.5
